# Public site URL used for canonical, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=

# Server-only agent planner (optional). Without a key the deterministic plan is used.
# Provider presets: deepseek=deepseek-flash | kimi=kimi-k3 | codex=gpt-5.1-codex-max |
# openai=gpt-5.1
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_API_KEY=
# Optional overrides; empty values fall back to the provider preset.
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
# chat-completions | responses (codex defaults to responses)
AGENT_LLM_PROTOCOL=
AGENT_LLM_TIMEOUT_MS=4000
# Provider-specific keys used when AGENT_LLM_API_KEY is empty.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# Server-only backend MCP endpoints (JSON-RPC tools/call). Empty = in-process mock
# for that server; CRB and RWA can be connected independently.
# CRB tools: setup_crb_funding, check_crb_balance, execute_crb_payment,
#            reject_payment, verify_crb_settlement
MCP_CRB_SERVER_URL=
MCP_CRB_SERVER_TOKEN=
# RWA tools: create_trade_order, execute_onchain_settlement, confirm_delivery
MCP_RWA_SERVER_URL=
MCP_RWA_SERVER_TOKEN=
