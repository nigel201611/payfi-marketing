# Public site URL used for canonical, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://nigel201611.github.io/payfi-marketing

# Server-only agent planner (optional). Without a key the deterministic plan is used.
# Provider presets: deepseek=deepseek-flash | kimi=kimi-k3 | codex=gpt-5.1-codex-max |
# openai=gpt-5.1
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_API_KEY=
# Optional overrides; empty values fall back to the provider preset.
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
# chat-completions | responses (codex defaults to responses)
AGENT_LLM_PROTOCOL=
AGENT_LLM_TIMEOUT_MS=4000
# Provider-specific keys used when AGENT_LLM_API_KEY is empty.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# Server-only backend MCP endpoint (JSON-RPC tools/call). Empty = in-process mock.
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
