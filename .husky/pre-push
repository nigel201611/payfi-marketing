#!/usr/bin/env sh
STRICT=${HUSKY_STRICT:-1}
SKIP_BUILD=${HUSKY_SKIP_BUILD:-0}

echo "--- [pre-push] Type check ---"
pnpm run type-check || {
  echo "Type check failed"
  [ "$STRICT" = "1" ] && exit 1
}

echo "--- [pre-push] Lint ---"
pnpm run lint || {
  echo "Lint failed"
  [ "$STRICT" = "1" ] && exit 1
}

echo "--- [pre-push] Unit tests ---"
pnpm run test || {
  echo "Tests failed"
  [ "$STRICT" = "1" ] && exit 1
}

if [ "$SKIP_BUILD" = "0" ]; then
  echo "--- [pre-push] Build ---"
  pnpm run build || {
    echo "Build failed"
    [ "$STRICT" = "1" ] && exit 1
  }
else
  echo "--- [pre-push] Skipping build (HUSKY_SKIP_BUILD=1) ---"
fi

echo "--- [pre-push] All checks passed ---"
